EDUCODER_TOKEN=''
EDUCODER_COOKIE=''
# Optional: automatically restore an expired session through the password form.
EDUCODER_LOGIN_ACCOUNT=''
EDUCODER_LOGIN_PASSWORD=''
SERVERCHAN_SENDKEY=''
# Generated from get_user_info.json login; no manual classroom URL required.
EDUCODER_CLASSROOMS_URL=''
TZ='Asia/Shanghai'
SYNC_INTERVAL_HOURS=6
REMINDER_CHECK_INTERVAL_SECONDS=60
# Required before enabling automatic reminders: once or daily.
UNDATED_REMINDER_MODE=''
# defer: retry on a later day if still due; skip: skip this reminder stage.
QUOTA_POLICY=''
# Local daily request cap, including failures/test notifications. Not a SC3 plan claim.
SERVERCHAN_DAILY_LIMIT=5
# --- AI 自动做题（OpenAI 兼容接口）---
# 当本地题库（answers.json / answer/）缺少某题答案时，用 AI 根据题目生成答案，
# 评测通过后把答案写回本地。base_url 兼容 DeepSeek / OpenAI / Kimi / Qwen 等。
AI_API_KEY=''
AI_BASE_URL='https://api.deepseek.com'
AI_MODEL='deepseek-flash'
# 代码/绘图题专用模型（可选）：留空则用 AI_MODEL。
# 统一使用 deepseek-flash，避免 deepseek-v4-pro 成本过高。
AI_CODE_MODEL='deepseek-flash'
# 代码题评测失败后，AI 按评测反馈修正的重试次数（默认 3）。
AI_CODE_MAX_RETRIES=3
